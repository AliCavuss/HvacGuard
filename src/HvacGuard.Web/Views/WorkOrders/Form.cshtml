@model WorkOrderFormModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit work order" : "New work order";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Work orders</a></li>
        <li class="breadcrumb-item active">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="page-header"><div><h1>@ViewData["Title"]</h1></div></div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="AlarmId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            @if (Model.AlarmId.HasValue)
            {
                <div class="alert alert-warning small"><i class="bi bi-link-45deg"></i> Linked to alarm: @(Model.AlarmMessage ?? $"#{Model.AlarmId}")</div>
            }

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UnitId" class="form-label"></label>
                    @if (Model.AlarmId.HasValue)
                    {
                        <input type="hidden" asp-for="UnitId" />
                        <input class="form-control" readonly value="@(Model.UnitOptions.FirstOrDefault(o => o.Value == Model.UnitId.ToString())?.Text)" />
                    }
                    else
                    {
                        <select asp-for="UnitId" asp-items="Model.UnitOptions" class="form-select">
                            <option value="0">— select unit —</option>
                        </select>
                    }
                    <span asp-validation-for="UnitId" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" asp-items="Ui.EnumOptions<WorkOrderPriority>(Model.Priority)" class="form-select"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssignedTo" class="form-label"></label>
                    <select asp-for="AssignedTo" asp-items="Model.AssigneeOptions" class="form-select">
                        <option value="">— unassigned —</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn btn-outline-secondary" asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
