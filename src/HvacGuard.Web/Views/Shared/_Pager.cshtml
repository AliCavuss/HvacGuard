@model IPagedResult
@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Pagination" class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-secondary small">Page @Model.Page of @Model.TotalPages · @Model.TotalCount records</span>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" href="@Context.Request.WithQuery("page", (Model.Page - 1).ToString())">&laquo;</a>
            </li>
            @for (var p = start; p <= end; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Context.Request.WithQuery("page", p.ToString())">@p</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" href="@Context.Request.WithQuery("page", (Model.Page + 1).ToString())">&raquo;</a>
            </li>
        </ul>
    </nav>
}
else if (Model.TotalCount > 0)
{
    <div class="text-secondary small mt-3">@Model.TotalCount records</div>
}
