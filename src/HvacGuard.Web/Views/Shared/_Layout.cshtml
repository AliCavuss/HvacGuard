@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · HvacGuard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
@if (isAuthenticated)
{
    <div class="app-shell">
        <aside class="sidebar d-flex flex-column">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-wind"></i>
                <span>Hvac<strong>Guard</strong></span>
            </a>
            <nav class="nav flex-column mt-3">
                <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="nav-link @Active("Vessels") @Active("Units")" asp-controller="Vessels" asp-action="Index"><i class="bi bi-water"></i> Fleet</a>
                <a class="nav-link @Active("Alarms")" asp-controller="Alarms" asp-action="Index">
                    <i class="bi bi-bell"></i> Alarms
                    <span id="nav-alarm-badge" class="badge rounded-pill text-bg-danger ms-auto d-none">0</span>
                </a>
                <a class="nav-link @Active("WorkOrders")" asp-controller="WorkOrders" asp-action="Index"><i class="bi bi-wrench-adjustable"></i> Work orders</a>
                @if (User.CanManageAssets())
                {
                    <div class="nav-section">Administration</div>
                    <a class="nav-link @Active("AlarmRules")" asp-controller="AlarmRules" asp-action="Index"><i class="bi bi-sliders"></i> Alarm rules</a>
                }
            </nav>
            <div class="mt-auto sidebar-footer">
                <div class="connection-state" id="connection-state" title="Real-time connection">
                    <span class="dot"></span><span class="label">Connecting…</span>
                </div>
                <div class="small text-secondary text-truncate">@(User.Identity?.Name)</div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-box-arrow-right"></i> Sign out</button>
                </form>
            </div>
        </aside>

        <main class="content">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toast-container"></div>
}
else
{
    <main class="auth-shell">
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@if (isAuthenticated)
{
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
