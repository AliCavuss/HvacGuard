@model VesselDetailsViewModel
@{
    var v = Model.Vessel;
    ViewData["Title"] = v.Name;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Fleet</a></li>
        <li class="breadcrumb-item active">@v.Name</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>@v.Name</h1>
        <p>@v.VesselType · IMO <code>@v.ImoNumber</code> · Flag: @v.Flag @(v.Owner is null ? "" : $"· {v.Owner}")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Alarms" asp-action="Index" asp-route-vesselId="@v.Id"><i class="bi bi-bell"></i> Alarms</a>
        <a class="btn btn-outline-secondary" asp-controller="WorkOrders" asp-action="Index" asp-route-vesselId="@v.Id"><i class="bi bi-wrench-adjustable"></i> Work orders</a>
        @if (User.CanManageAssets())
        {
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@v.Id"><i class="bi bi-pencil"></i> Edit</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@v.Id"><i class="bi bi-trash"></i></a>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="section-title mb-0">Air handling units (@Model.Units.Count)</h2>
    @if (User.CanManageAssets())
    {
        <a class="btn btn-sm btn-primary" asp-controller="Units" asp-action="Create" asp-route-vesselId="@v.Id"><i class="bi bi-plus-lg"></i> Add unit</a>
    }
</div>

@if (Model.Units.Count == 0)
{
    <div class="empty-state">This vessel has no units yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var unit in Model.Units)
        {
            <partial name="_UnitCard" model="unit" />
        }
    </div>
}

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
