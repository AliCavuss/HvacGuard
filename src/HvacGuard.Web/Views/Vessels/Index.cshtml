@model IReadOnlyList<VesselListItem>
@{
    ViewData["Title"] = "Fleet";
}
<div class="page-header">
    <div>
        <h1>Fleet</h1>
        <p>Vessels under monitoring and their air handling units.</p>
    </div>
    @if (User.CanManageAssets())
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add vessel</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">No vessels yet.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th>Vessel</th>
                    <th>IMO</th>
                    <th>Type</th>
                    <th>Flag</th>
                    <th class="text-end">Units</th>
                    <th class="text-end">Open alarms</th>
                    <th class="text-end">Open work orders</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold" asp-action="Details" asp-route-id="@v.Id">@v.Name</a>
                            @if (!string.IsNullOrEmpty(v.Owner))
                            {
                                <div class="small text-secondary">@v.Owner</div>
                            }
                        </td>
                        <td><code>@v.ImoNumber</code></td>
                        <td>@v.VesselType</td>
                        <td>@v.Flag</td>
                        <td class="text-end">@v.UnitCount</td>
                        <td class="text-end">
                            @if (v.OpenAlarmCount > 0)
                            {
                                <a class="badge text-bg-danger" asp-controller="Alarms" asp-action="Index" asp-route-vesselId="@v.Id">@v.OpenAlarmCount</a>
                            }
                            else
                            {
                                <span class="text-secondary">0</span>
                            }
                        </td>
                        <td class="text-end">@v.OpenWorkOrderCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
