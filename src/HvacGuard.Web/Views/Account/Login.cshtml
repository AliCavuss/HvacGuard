@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-card">
    <div class="text-center mb-4">
        <div class="auth-logo"><i class="bi bi-wind"></i></div>
        <h1 class="h4 mb-1">Hvac<strong>Guard</strong></h1>
        <p class="text-secondary small mb-0">Marine HVAC monitoring &amp; maintenance</p>
    </div>

    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary w-100">Sign in</button>
    </form>

    <div class="demo-accounts mt-4">
        <div class="small text-secondary mb-2"><i class="bi bi-info-circle"></i> Demo accounts (click to fill)</div>
        @foreach (var (email, password, _, role) in HvacGuard.Infrastructure.Data.DbSeeder.DemoUsers)
        {
            <button type="button" class="demo-account" data-email="@email" data-password="@password">
                <span class="badge text-bg-secondary">@role</span> <code>@email</code>
            </button>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.demo-account').forEach(btn => btn.addEventListener('click', () => {
            document.getElementById('Email').value = btn.dataset.email;
            document.getElementById('Password').value = btn.dataset.password;
        }));
    </script>
}
